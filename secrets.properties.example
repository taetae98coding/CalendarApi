# 로컬 실행용 인증키 템플릿입니다.
#
# 이 파일을 secrets.properties 로 복사한 뒤 값을 채우세요. secrets.properties 는 .gitignore 대상이라 커밋되지 않습니다.
#
#   cp secrets.properties.example secrets.properties
#
# GitHub Actions 에서는 같은 이름의 저장소 시크릿을 사용합니다.
# Settings > Secrets and variables > Actions > New repository secret
#
# 키 이름은 {제공처}_{용도} 규칙을 따릅니다. 제공처가 늘어나면 여기에 항목을 추가하세요.


# ── 공공데이터포털 (data.go.kr) ────────────────────────────────────────────────
# 계정당 하나인 일반 인증키(Decoding). URL 인코딩된 키(%2B, %3D 가 섞인 값)가 아닙니다.
#
# 키는 하나지만 API(서비스)마다 활용신청을 따로 해야 합니다. 아래 둘 다 신청하세요. (자동 승인)
# - 한국천문연구원_특일 정보   https://www.data.go.kr/tcs/dss/selectApiDataDetailView.do?publicDataPk=15012690
# - 한국천문연구원_음양력 정보 https://www.data.go.kr/data/15012679/openapi.do
DATA_GO_KR_SERVICE_KEY=


# ── Nager.Date (date.nager.at) ─────────────────────────────────────────────────
# 인증키가 필요 없습니다.
